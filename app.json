{
  "expo": {
    "name": "MZOBS Employer",
    "slug": "mzobs-employer-app",
    "version": "1.0.0",
    "scheme": "mzobs-employer",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.mzobs.employer",
      "buildNumber": "4",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Mzobs Recruiter needs access to your photos only when you choose a file or image to upload."
      }
    },
    "android": {
      "package": "com.mzobs.employer",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#00276B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#08685E",
          "defaultChannel": "default"
        }
      ],
      "expo-web-browser",
      "expo-iap",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#002C69"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "targetSdkVersion": 36,
            "compileSdkVersion": 36,
            "minSdkVersion": 24
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "2b968f4e-e46b-4af3-9b76-3be4e3c3f621"
      }
    },
    "owner": "utkarsh9955"
  }
}
